{
  "name": "@kikojs/dom",
  "version": "0.4.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiko-js/kiko.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./hmr": {
      "types": "./dist/hmr.d.ts",
      "default": "./dist/hmr.js"
    },
    "./hydrate": {
      "types": "./dist/hydrate.d.ts",
      "default": "./dist/hydrate.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./react-portal": {
      "types": "./dist/react-portal.d.ts",
      "default": "./dist/react-portal.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun build.ts",
    "demo": "bun run examples/demo.tsx",
    "prepublishOnly": "bun ../../scripts/check-publish.ts && bun run build && bun test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@kikojs/hmr": "^0.1.0",
    "signal-polyfill": "^0.2.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
