{
  "name": "@kikojs/signal",
  "version": "0.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiko-js/kiko.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun build.ts",
    "test": "bun test",
    "prepublishOnly": "bun ../../scripts/check-publish.ts && bun ../../scripts/prebuild-deps.ts && bun run build && bun test",
    "prepack": "bun ../../scripts/prebuild-deps.ts && bun run build"
  },
  "dependencies": {
    "signal-polyfill": "^0.2.0"
  },
  "engines": {
    "bun": ">=1.0"
  }
}
