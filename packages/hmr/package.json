{
  "name": "@kikojs/hmr",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiko-js/kiko.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./transform": {
      "types": "./dist/transform.d.ts",
      "default": "./dist/transform.js"
    },
    "./watcher": {
      "types": "./dist/watcher.d.ts",
      "default": "./dist/watcher.js"
    },
    "./bun": {
      "types": "./dist/bun/index.d.ts",
      "default": "./dist/bun/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun build.ts",
    "test": "bun test",
    "prepublishOnly": "bun ../../scripts/check-publish.ts && bun ../../scripts/prebuild-deps.ts && bun run build && bun test",
    "prepack": "bun ../../scripts/prebuild-deps.ts && bun run build"
  },
  "dependencies": {
    "oxc-parser": "^0.148.0",
    "signal-polyfill": "^0.2.0"
  },
  "devDependencies": {
    "@kikojs/dom": "workspace:*"
  },
  "engines": {
    "bun": ">=1.2.4",
    "node": ">=18"
  }
}
